# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# DRY_RUN=true simulates every on-chain call (safe, no funds touched — a
# simulated fee vault stands in for the real escrow). Set to false ONLY after
# a funded wallet + RPC are configured and validated with scripts/check.js.
DRY_RUN=true

# ── Robinhood Chain (EVM) ────────────────────────────────────────────────────
# Defaults target Robinhood Chain mainnet (chain id 4663).
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
# Blockscout instance (REST API, no key needed) — holder snapshots.
EXPLORER_API=https://robinhoodchain.blockscout.com

# Signing wallet: 0x-prefixed hex private key. MUST be BABYBUNDLECAT's
# `creatorFeeRecipient` — the ONLY address authorized to sweep AND claim fees,
# in both the bonding-curve and Uniswap v4 phases. It is set once in
# TokenParams at launch and may differ from the wallet that launched the
# token. If this wallet is not the creatorFeeRecipient, the bot runs without
# error but the cycle starves — nothing is ever claimable. In DRY_RUN leave
# blank; an ephemeral wallet is generated. Verify with `node scripts/check.js`
# (the "feeRecip." line).
WALLET_PRIVATE_KEY=

# ── pons v2 + Uniswap v4 contracts (Robinhood Chain — verified 2026-08-14) ────
# Overridable per chain/deployment, but scripts/check.js re-reads the escrow,
# hook, and pool manager live from the factory and warns if these differ.
PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
MEME_HOOK=0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044
FEE_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
BUYBACK_VAULT=0x42df2a798f82289E177311362e8f5ccC45c1219c
POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
UNIVERSAL_ROUTER=0x8876789976decbfcbbbe364623c63652db8c0904
STATE_VIEW=0x0284Cb0bcbaa8B87A8AA409D0e41afA7a76355F2
V4_QUOTER=0x5c3db48cFd8352D845fac70009d714F0Ce1d7914

# ── Tokens ───────────────────────────────────────────────────────────────────
# TOKEN_ADDRESS is BABYBUNDLECAT — leave blank until it is launched on pons v2.
# Filled in AFTER launch, once you know the deployed address.
TOKEN_ADDRESS=
TOKEN_SYMBOL=BABYBUN                 # the site says $BABYBUN
# BUN: bought with REWARD_BUY_PCT of each claim and airdropped to BABY
# BUN holders. Already launched and graduated to Uniswap v4.
REWARD_TOKEN=0x07EBB29a38Fbcb41563817e5E19f2ceC619C90D2
REWARD_SYMBOL=BUN

# ── Split (of each escrow claim, native ETH) ────────────────────────────────
# Three legs, and the two together may not exceed 100 — the bot refuses to
# start if they do:
#   REWARD_BUY_PCT -> buys BUN and airdrops it to BABYBUNDLECAT holders
#   BURN_PCT       -> buys BABYBUNDLECAT and sends it to DEAD_ADDRESS
#   remainder      -> the dev cut + gas. Already native ETH in the wallet, so
#                     it costs no transaction and needs no unwrap.
REWARD_BUY_PCT=70
BURN_PCT=20                        # dev cut = 100 - REWARD_BUY_PCT - BURN_PCT
# Floor for the reward leg, in ETH. If REWARD_BUY_PCT of a claim comes to less
# than this, the buy+airdrop is SKIPPED for that cycle (recorded as a skipped
# step; the cycle still completes) and the dust stays in the wallet as native
# ETH. The default is the 1e-6 ETH boundary below which such an amount cannot
# be written as a plain decimal — and a reward that small is not worth the gas.
MIN_REWARD_ETH=0.000001
SLIPPAGE_PCT=5                      # buy-swap slippage tolerance, percent (curve + v4)
GAS_RESERVE_ETH=0.005               # native ETH kept back for gas, informational
DEAD_ADDRESS=0x000000000000000000000000000000000000dEaD

# What was MINTED, used for the burned-share figure /api/stats publishes. A
# transfer to the dead address leaves totalSupply alone, so this is the
# denominator. pons v2 launches mint 1,000,000,000.
TOKEN_TOTAL_SUPPLY=1000000000

# ── Airdrop (BUN → BABYBUNDLECAT holders) ──────────────────────────────────
MIN_HOLD=100000                     # min BABYBUNDLECAT balance to qualify for the airdrop
REWARD_CAP_PCT=0                    # per-wallet weight cap, % of supply (0 = pure pro-rata)
                                    # fractions are honoured down to 0.0000001
CLUSTERS=[]                         # JSON array of address-groups treated as one wallet
                                    # (each group is capped as ONE holder, then split
                                    #  internally pro-rata). Address casing is ignored.
AIRDROP_EXCLUDE=                    # extra excluded owners, comma-separated (casing ignored)
AIRDROP_BATCH_SIZE=30               # max airdrop txs in flight at once; also recipients per disperse batch
AIRDROP_GAS_LIMIT=120000            # fixed gas per airdrop transfer (skips per-tx estimateGas)
DISPERSE_ADDRESS=                   # batch-transfer contract; blank -> pipelined transfers (fine at low holder counts, see README)

# ── Trigger ──────────────────────────────────────────────────────────────────
# The scheduler ticks on POLL_SCHEDULE. TRIGGER_MODE decides the gate:
#   accumulation -> fire once the claim is worth CLAIM_EVERY_USD (default)
#   interval     -> fire on whatever has accrued every tick
# A cycle pays one transaction per holder, so the gate is what stops a small
# claim being spent on its own gas.
TRIGGER_MODE=accumulation
POLL_SCHEDULE=*/5 * * * *           # every 5 minutes
CLAIM_EVERY_USD=100                 # the real gate: fire at $100 of claimable fees
# Fallback, used only when CLAIM_EVERY_USD is 0 or the ETH price is briefly
# unavailable — a price outage must not hold fees back for good.
CLAIM_EVERY_ETH=0.005
# DRY_RUN only: simulated ETH accrued to the vault per tick (so cycles have fees).
DRY_RUN_FEE_PER_POLL=0.01

# ── Market data (optional) ───────────────────────────────────────────────────
DEXSCREENER_CHAIN_ID=robinhood

# ── Storage (MongoDB) ────────────────────────────────────────────────────────
# Local mongod, or a MongoDB Atlas SRV URI (mongodb+srv://user:pass@cluster/...).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=bbbun

# ── Frontend / CORS ──────────────────────────────────────────────────────────
# Comma-separated allowlist of browser origins that may call the API.
# Use "*" to allow any origin (not recommended). Non-browser calls always pass.
CORS_ORIGINS=https://babybundlecat.meme,https://www.babybundlecat.meme,http://localhost:5173

# Secret protecting POST /api/run|pause|resume. Blank = open (dev only).
# In production set a long random string; send it as header x-api-key: <key>.
API_KEY=
